{
  "name": "medicare-portal",
  "version": "2.0.0",
  "description": "Medicare Portal – Full-Stack Healthcare Management System (Node.js, Express, MongoDB Atlas, React, JWT RBAC)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "client": "npm --prefix frontend run dev",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "healthcare",
    "patient-management-system",
    "mern-stack",
    "electronic-health-records",
    "react",
    "nodejs",
    "express",
    "mongodb-atlas",
    "jwt-auth",
    "rbac"
  ],
  "author": "Medicare Portal Team",
  "license": "MIT"
}
