# MongoDB Atlas Connection String
# Get your URI from https://cloud.mongodb.com -> Connect -> Connect your application
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medicare?retryWrites=true&w=majority

# Secret for signing JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# Application Port
PORT=5000

# Environment Mode
NODE_ENV=production
